# Database configuration
DATABASE_URL=postgresql+psycopg2://user:password@localhost/netradhrishti

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="Netradhrishti SOC Platform"
ENVIRONMENT=development

# Security / Authentication
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External Integrations (placeholders)
OPENAI_API_KEY=your_openai_api_key_here
THREAT_INTEL_API_KEY=your_ti_provider_key_here

# Logging
LOG_LEVEL=INFO
